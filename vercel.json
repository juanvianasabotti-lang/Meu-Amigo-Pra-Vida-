{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/googlef2e73a6ff4e22311.html",
      "destination": "/verificacao/googlef2e73a6ff4e22311.txt"
    },
    {
      "source": "/adote/:slug",
      "destination": "/animal.html"
    },
    {
      "source": "/adotar/:slug",
      "destination": "/adotar.html"
    },
    {
      "source": "/organizacao/:slug",
      "destination": "/organizacao.html"
    },
    {
      "source": "/eventos/:slug",
      "destination": "/evento.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/artigo.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/auth-callback.html"
    },
    {
      "source": "/minha-conta/:path*",
      "destination": "/minha-conta.html"
    },
    {
      "source": "/painel/:path*",
      "destination": "/painel.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://phfeodwytcvrnesythiv.supabase.co https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://phfeodwytcvrnesythiv.supabase.co https://viacep.com.br; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://phfeodwytcvrnesythiv.supabase.co; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(img|brand|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/verificacao/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "framework": null
}
